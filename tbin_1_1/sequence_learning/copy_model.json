{
  "version": 1,
  "rules": [
    {
      "input_prefix": "My name is ",
      "input_suffix": ". Say hello.",
      "output_prefix": "Hello, ",
      "output_suffix": "!",
      "support": 8
    },
    {
      "input_prefix": "Write Python function ",
      "input_suffix": " to add a and b.",
      "output_prefix": "def ",
      "output_suffix": "(a, b):\n    return a + b",
      "support": 6
    },
    {
      "input_prefix": "Write Python function ",
      "input_suffix": " to subtract b from a.",
      "output_prefix": "def ",
      "output_suffix": "(a, b):\n    return a - b",
      "support": 6
    },
    {
      "input_prefix": "My name is ",
      "input_suffix": "n. Say hello.",
